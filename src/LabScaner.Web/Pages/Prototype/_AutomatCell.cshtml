@model ProtoStudent
@{
    var state = JournalPrototypeStore.Automat(Model);
}
<td id="a@(Model.Id)" class="jt__auto">
    @switch (state)
    {
        case AutomatState.Given:
            <span class="auto auto--given">★ Автомат 5</span>
            break;
        case AutomatState.Candidate:
            <span class="auto auto--candidate">★ претендует</span>
            break;
        case AutomatState.WaitsCoursework:
            <span class="auto auto--waits">ждёт курсовую</span>
            break;
        default:
            <span class="auto">—</span>
            break;
    }
</td>
