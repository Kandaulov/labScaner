@model SelectionModel
<div class="modal" role="dialog" aria-labelledby="auto-h">
    <div class="modal__box">
        <h2 id="auto-h">Поставить автомат «5 (отлично)»?</h2>
        @if (Model.Candidates.Count == 0)
        {
            <p>Среди выбранных нет претендентов на автомат.</p>
        }
        else
        {
            <p>Оценка попадёт в графу «Экзамен» с пометкой «автомат» — @Model.Candidates.Count студентам:</p>
            <ul>
                @foreach (var s in Model.Candidates)
                {
                    <li>@s.FullName</li>
                }
            </ul>
        }
        @foreach (var s in Model.Skipped)
        {
            <div class="alert alert--warn">Пропущен(а): <b>@s.ShortName</b> — @(JournalPrototypeStore.Automat(s) == AutomatState.WaitsCoursework ? "курсовая ещё не принята" : "не все лабы приняты в срок"), на автомат не претендует.</div>
        }
        <div class="muted">Снять автомат можно вручную в ячейке «Экзамен». Студентам ничего не отправляется.</div>
        <div class="modal__actions">
            <button type="button" class="button" data-close-modal>Отмена</button>
            @if (Model.Candidates.Count > 0)
            {
                <button type="button" class="button button--accepted" hx-post="@Url.Page("/Prototype/Journal", "AutoApply")" hx-include=".jt__check">Поставить @Model.Candidates.Count автомат(а)</button>
            }
        </div>
    </div>
</div>
