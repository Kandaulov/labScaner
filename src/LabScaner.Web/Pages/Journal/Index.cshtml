@page
@{
    ViewData["Title"] = "Журнал группы";
    ViewData[NavMenu.ActiveKey] = NavMenu.Journal;
}
<partial name="_PageHeader" model='@("Журнал группы")' />
<section class="card">
    <partial name="_Empty" model='@(new EmptyState("Журнал пока пуст", "Заведите предмет, семестр и группу — здесь появится таблица: студенты, лабораторные, курсовая, экзамен или зачёт.", "Перейти к предметам", "/Subjects"))' />
</section>
<div class="banner">
    <span class="banner__text">Пока журнал пуст, можно посмотреть <b>прототип</b> на тестовых данных: 25 студентов, быстрая отметка, карточка сдачи, автомат.</span>
    <a href="/Prototype/Journal">Открыть прототип</a>
</div>
