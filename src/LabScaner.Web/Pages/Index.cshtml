@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}
<h1>labScaner</h1>
<p>Здравствуйте, @Model.DisplayName!</p>
<p class="muted">Роли: @string.Join(", ", Model.RoleTitles). Версия @Model.Version. Интерфейс по макетам появится на шаге 2.4.</p>
@if (Model.IsAdmin)
{
    <p><a href="/Admin">Администрирование</a></p>
}
<form method="post" asp-page="/Account/Logout">
    <button type="submit">Выйти</button>
</form>
