@page
@model PasswordModel
@{
    ViewData["Title"] = "Смена пароля";
    ViewData[NavMenu.ActiveKey] = NavMenu.Settings;
}
<partial name="_PageHeader" model='@("Смена пароля")' />

@if (Model.Forced)
{
    <div class="banner" role="status">
        <span class="banner__text"><b>Пароль выдан администратором.</b> Придумайте свой, чтобы продолжить работу.</span>
    </div>
}
@if (Model.Done)
{
    <div class="notice notice--ok" role="status">Пароль изменён.</div>
}

<section class="card form-card">
    <form method="post" class="form">
        @if (Model.Error is not null)
        {
            <div class="alert" role="alert">@Model.Error</div>
        }
        <label class="field">Текущий пароль
            <input asp-for="Current" type="password" autocomplete="current-password" required />
        </label>
        <label class="field">Новый пароль
            <input asp-for="New" type="password" autocomplete="new-password" minlength="10" required />
            <span class="field__hint">Не короче 10 символов. Удобно — фраза из нескольких слов.</span>
        </label>
        <label class="field">Повторите новый пароль
            <input asp-for="Repeat" type="password" autocomplete="new-password" required />
        </label>
        <div class="form__actions">
            <button type="submit" class="button button--primary">Сменить пароль</button>
            @if (!Model.Forced)
            {
                <a class="button" href="/Settings">Отмена</a>
            }
        </div>
    </form>
</section>
