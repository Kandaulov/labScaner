@page
@{
    ViewData["Title"] = "Настройки";
    ViewData[NavMenu.ActiveKey] = NavMenu.Settings;
    var isAdmin = User.IsInRole(Roles.Admin);
}
<partial name="_PageHeader" model='@("Настройки")' />

<section class="card" aria-labelledby="my-h">
    <div class="card__header"><h2 id="my-h">Мои настройки</h2></div>
    <div class="settings-list">
        <div class="settings-item"><span class="settings-item__title">Почта</span><span class="settings-item__text">IMAP — приём работ, SMTP — отправка уведомлений, интервал автопроверки</span></div>
        <div class="settings-item"><span class="settings-item__title">Яндекс Диск</span><span class="settings-item__text">Подключение к Диску, куда раскладываются работы</span></div>
        <div class="settings-item"><span class="settings-item__title">Шаблоны писем</span><span class="settings-item__text">Текст уведомлений студентам с переменными</span></div>
        <div class="settings-item"><span class="settings-item__title">Смена пароля</span><span class="settings-item__text">Пароль — не короче 10 символов</span></div>
    </div>
</section>

@if (isAdmin)
{
    <section class="card" aria-labelledby="admin-h">
        <div class="card__header"><h2 id="admin-h">Администрирование</h2><a href="/Admin">Открыть</a></div>
        <div class="settings-list">
            <div class="settings-item"><span class="settings-item__title">Пользователи</span><span class="settings-item__text">Преподаватели: добавить, заблокировать, сбросить пароль</span></div>
            <div class="settings-item"><span class="settings-item__title">Учебный календарь</span><span class="settings-item__text">Семестры, зачётная неделя, сессия</span></div>
            <div class="settings-item"><span class="settings-item__title">ИИ</span><span class="settings-item__text">Провайдер, модель, лимиты; обезличивание всегда включено</span></div>
            <div class="settings-item"><span class="settings-item__title">Группы и студенты</span><span class="settings-item__text">Общий справочник для всех преподавателей</span></div>
        </div>
    </section>
}
<p class="muted">Разделы настроек заработают на этапе 3.</p>
