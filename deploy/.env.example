# Скопируйте в .env (он в .gitignore) и заполните. Пароли — длинные случайные строки.

# Домен сайта. Для запуска на своём компьютере оставьте localhost.
DOMAIN=localhost

# Пароль БД PostgreSQL (контейнер db).
DB_PASSWORD=

# Первый администратор: создаётся при первом запуске, если администратора ещё нет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Кандаулов В. М.

# Приложение Яндекса для доступа к Диску (oauth.yandex.ru → ваше приложение): ClientID и Client secret.
# Пока пусто — подключить Диск нельзя, остальное работает.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Образ приложения. По умолчанию — последняя сборка ветки main из GitHub (GHCR).
# Чтобы собрать локально из исходников: docker compose up -d --build
APP_IMAGE=ghcr.io/kandaulov/labscaner:main

# Порты на хосте (если 80/443 заняты).
HTTP_PORT=80
HTTPS_PORT=443
