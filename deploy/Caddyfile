# Домен — из .env (DOMAIN). Для настоящего домена Caddy сам получает сертификат Let's Encrypt;
# для localhost — выпускает локальный (браузер предупредит, это нормально).
{$LABSCANER_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
